{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StructuraLens Configuration",
  "description": "Configuration file for StructuraLens code analysis tool",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference"
    },
    "inheritanceDepth": {
      "type": "integer",
      "description": "Maximum depth for configuration inheritance (default: 10)",
      "default": 10,
      "minimum": 1,
      "maximum": 50
    },
    "coupling": {
      "type": "object",
      "description": "Coupling analysis configuration",
      "properties": {
        "mode": {
          "type": "string",
          "description": "Coupling analysis mode",
          "enum": ["internal", "filtered", "all"],
          "default": "filtered"
        },
        "excludePatterns": {
          "type": "array",
          "description": "Patterns to exclude from coupling analysis",
          "items": {
            "type": "string"
          },
          "default": ["System.*", "Microsoft.*"]
        },
        "includePatterns": {
          "type": "array",
          "description": "Patterns to explicitly include (overrides excludePatterns)",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "patternType": {
          "type": "string",
          "description": "Type of pattern matching to use",
          "enum": ["wildcard", "regex", "exact"],
          "default": "wildcard"
        },
        "trackExternalDependencies": {
          "type": "boolean",
          "description": "Whether to track dependencies on external libraries",
          "default": true
        },
        "groupByAssembly": {
          "type": "boolean", 
          "description": "Group external dependencies by assembly rather than namespace",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "description": "Metrics calculation configuration",
      "properties": {
        "includeTests": {
          "type": "boolean",
          "description": "Include test projects in metrics calculation",
          "default": true
        },
        "excludeGenerated": {
          "type": "boolean",
          "description": "Exclude generated code from metrics",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "description": "Output configuration",
      "properties": {
        "includeSourceLocations": {
          "type": "boolean",
          "description": "Include source file locations in dependency output",
          "default": false
        },
        "maxDependenciesInSummary": {
          "type": "integer",
          "description": "Maximum number of dependencies to show in summary",
          "default": 10,
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "rules": {
      "type": "array",
      "description": "Architecture linting rules to enforce dependency constraints",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique rule identifier"
          },
          "description": {
            "type": "string",
            "description": "Human-readable rule description"
          },
          "severity": {
            "type": "string",
            "enum": ["error", "warning", "info"],
            "default": "warning",
            "description": "Severity level. 'error' causes non-zero exit code."
          },
          "enabled": {
            "type": "boolean",
            "default": true,
            "description": "Whether this rule is active"
          },
          "from": {
            "type": "string",
            "default": "*",
            "description": "Pattern matching source entities this rule applies to"
          },
          "allow": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Allowed dependency patterns. If specified, only these are permitted."
          },
          "disallow": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Disallowed dependency patterns. These dependencies are forbidden."
          },
          "dependencyType": {
            "type": "string",
            "enum": ["any", "project", "namespace", "type"],
            "default": "any",
            "description": "What type of dependency this rule applies to"
          }
        },
        "required": ["id"]
      }
    }
  },
  "additionalProperties": false
}
