{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StructuraLens Config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "IsEnabled": { "type": "boolean", "default": true },
    "CheckAssemblyDependencies": { "type": "boolean", "default": false },
    "MaxIssueCount": { "type": "integer", "minimum": 1, "default": 100 },
    "AutoLowerMaxIssueCount": { "type": "boolean", "default": false },
    "InheritanceDepth": { "type": "integer", "minimum": 0, "default": 0 },
    "ExcludedFiles": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "ProjectFilters": {
      "type": "object",
      "properties": {
        "Include": { "type": "array", "items": { "type": "string" }, "default": [] },
        "Exclude": { "type": "array", "items": { "type": "string" }, "default": [] }
      },
      "additionalProperties": false,
      "default": {}
    },
    "Rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["Type", "From", "To", "Scope"],
        "properties": {
          "Id": { "type": "string" },
          "Type": { "type": "string", "enum": ["Allowed", "Disallowed"] },
          "Scope": { "type": "string", "enum": ["Namespace", "Assembly", "Project"] },
          "From": { "type": "string" },
          "To": { "type": "string" },
          "Severity": { "type": "string", "enum": ["Info", "Warning", "Error"], "default": "Error" },
          "Message": { "type": "string" },
          "Comment": { "type": "string" }
        }
      },
      "default": []
    }
  },
  "required": ["IsEnabled", "Rules"]
}
