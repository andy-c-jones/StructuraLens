{
  "$schema": "https://json.schemastore.org/prettierrc",
  "tabWidth": 2,
  "useTabs": false,
  "overrides": [
    {
      "files": "**/*.{ts,tsx,js,jsx,astro,json,css}",
      "options": {
        "printWidth": 100,
        "semi": true,
        "singleQuote": false,
        "trailingComma": "all"
      }
    }
  ]
}
