<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Ensure native libraries are extracted for single-file publish -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- Allow test project to access internal types -->
  <ItemGroup>
    <InternalsVisibleTo Include="StructuraLens.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibGit2Sharp" Version="0.31.0" />
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.0.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />
    <!-- TEST: Deliberately added for dependency testing -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- SQLite for disk-backed dependency collection -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.2" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.2" />
  </ItemGroup>

  <!-- Exclude MSBuild runtime assemblies to allow MSBuild.Locator to load them at runtime -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Build" Version="18.0.2" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Framework" Version="18.0.2" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.0.2" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <!-- Embed the Astro-built HTML report template as a managed resource -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\web\dist\index.html" LogicalName="StructuraLens.Core.report-template.html" />
  </ItemGroup>

  <!-- Build the web template before compiling C# -->
  <Target Name="BuildWebTemplate" BeforeTargets="BeforeBuild"
          Condition="'$(SkipWebBuild)' != 'true' AND Exists('$(MSBuildThisFileDirectory)..\..\web\package.json')">
    <!-- Only run npm install if node_modules is missing -->
    <Exec Command="npm install --prefer-offline --no-audit"
          WorkingDirectory="$(MSBuildThisFileDirectory)..\..\web"
          Condition="!Exists('$(MSBuildThisFileDirectory)..\..\web\node_modules')" />
    <!-- Only rebuild if the template is older than the source files -->
    <Exec Command="npm run build"
          WorkingDirectory="$(MSBuildThisFileDirectory)..\..\web" />
  </Target>

</Project>
